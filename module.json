    "scripts/hover.js",
    "scripts/portrait-library.js"
  ],

  "styles": [
    "styles/styles.css",
    "styles/portrait-library.css"
  ],

  "templates": [
    "templates/portrait-library.html"
  ],

  "packs": [],

  "url": "https://github.com/WesleySniperss/hover-portrait",
  "manifest": "https://raw.githubusercontent.com/WesleySniperss/hover-portrait/main/module.json",
